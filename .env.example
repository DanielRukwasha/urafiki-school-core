# Copy to .env and fill in values for this school's deployment.
# Nothing school-specific belongs in code — this file (and the Institution
# table it seeds) is where per-deployment identity and secrets live.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL connection string for this deployment's own database.
DATABASE_URL=postgresql+psycopg://urafiki:urafiki@localhost:5432/urafiki_school_core

BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=false
