# Copier vers /etc/urafiki/sauvegarde.env (chmod 600, propriétaire urafiki).
# Rôle PostgreSQL propriétaire des tables ou BYPASSRLS : sinon pg_dump refuse
# de lire les tables protégées par Row Level Security (comportement voulu).
SAUVEGARDE_DATABASE_URL=postgresql://urafiki_sauvegarde:CHANGER@127.0.0.1:5432/urafiki
# Stockage objet hors du serveur (S3, Cloudflare R2, Backblaze B2, ...).
SAUVEGARDE_DESTINATION=s3://urafiki-sauvegardes/production
SAUVEGARDE_S3_ENDPOINT_URL=https://COMPTE.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=CHANGER
AWS_SECRET_ACCESS_KEY=CHANGER
AWS_DEFAULT_REGION=auto
# Phrase de passe GPG : générée une fois, conservée AUSSI hors du serveur
# (coffre de mots de passe de l'exploitation). Sans elle, aucune restauration.
SAUVEGARDE_PASSPHRASE_FILE=/etc/urafiki/sauvegarde.passphrase
